msgstr[0] "{n} vastgezet bestand"
msgstr[1] "{n} vastgezette bestanden"

#: crates/pdfs-gui/src/prompt.rs:1158
#, rust-format
msgid "{drive} in Drive · {local} on this computer · indexing…"
msgstr "{drive} in Drive · {local} op deze computer · indexeren…"

#. Translators: result counts in the footer; {drive} and {local} are numbers.
#: crates/pdfs-gui/src/prompt.rs:1163
