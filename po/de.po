msgstr "Anmeldung fehlgeschlagen: {error}"

#: crates/pdfs-gui/src/app/pages/login.rs:459
msgid "That mailbox password didn't unlock your account. Try again."
msgstr ""
"Das Postfach-Passwort hat Ihr Konto nicht entsperrt. Versuchen Sie es erneut."

#: crates/pdfs-gui/src/app/pages/login.rs:461
msgid ""
"This account has a separate mailbox password. Enter it to unlock your files."
